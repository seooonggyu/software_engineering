<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0/EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.software_engineering.mapper.ItemMapper">

	<!---->
	<select id="detail" parameterType="hashMap" resultType="com.project.software_engineering.dto.ItemDto$DetailResDto">
		SELECT item.id
			 , item.deleted
			 , item.created_at as createdAt
			 , item.modified_at as modifiedAt

			 , item.title
			 , item.content
		     , item.location
			 , item.category
			 , item.status
			 , item.start_tiem as startTime
			 , item.end_tiem as endTime
		FROM item
		WHERE item.id = #{id}
	</select>

	<!-- 공통 WHERE 절 -->
	<sql id="commonWhere">
		WHERE item.id is not NULL
		<if test = "deleted != null">AND item.deleted = #{deleted}</if>
		<if test="sdate != null and sdate != ''">AND item.created_at >= CONCAT(#{sdate}, ' 00:00:00')</if>
		<if test="fdate != null and fdate != ''">AND CONCAT(#{fdate}, ' 23:59:59') >= item.created_at</if>
		<if test = "title != null and title !=''">AND item.title LIKE CONCAT('%', #{title}, '%')</if>
	</sql>

	<select id="list" parameterType="hashMap" resultType="com.project.software_engineering.dto.ItemDto$DetailResDto">
		SELECT item.id
		FROM item
		<include refid="commonWhere"/>
		ORDER BY item.status ASC
	</select>

